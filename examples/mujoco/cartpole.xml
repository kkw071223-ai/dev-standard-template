<mujoco model="cartpole">
  <compiler angle="radian"/>
  <option timestep="0.005" gravity="0 0 -9.81"/>
  <worldbody>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.3 0.5 0.3 1"/>
    <body name="cart" pos="0 0 0.5">
      <joint name="slider" type="slide" axis="1 0 0" range="-2 2"/>
      <geom name="cart_g" type="box" size="0.1 0.05 0.05" mass="1" rgba="0.2 0.2 0.8 1"/>
      <body name="pole" pos="0 0 0.05">
        <joint name="hinge" type="hinge" axis="0 1 0"/>
        <geom name="pole_g" type="capsule" fromto="0 0 0 0 0 0.6" size="0.02" mass="0.3" rgba="0.8 0.2 0.2 1"/>
      </body>
    </body>
  </worldbody>
  <actuator><motor joint="slider" gear="100"/></actuator>
</mujoco>
