<?xml version="1.0"?>
<robot name="arm2">
  <link name="base_link">
    <visual><geometry><box size="0.2 0.2 0.05"/></geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material></visual>
    <collision><geometry><box size="0.2 0.2 0.05"/></geometry></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <link name="link1">
    <visual><geometry><cylinder length="0.3" radius="0.03"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.9 1"/></material></visual>
    <collision><geometry><cylinder length="0.3" radius="0.03"/></geometry></collision>
    <inertial><mass value="1.0"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.001"/></inertial>
  </link>
  <link name="gripper">
    <visual><geometry><sphere radius="0.04"/></geometry>
      <material name="red"><color rgba="0.9 0.1 0.1 1"/></material></visual>
    <collision><geometry><sphere radius="0.04"/></geometry></collision>
    <inertial><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="50" velocity="2.0"/>
  </joint>
  <joint name="wrist" type="revolute">
    <parent link="link1"/><child link="gripper"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-2.0" upper="2.0" effort="20" velocity="3.0"/>
  </joint>
</robot>
